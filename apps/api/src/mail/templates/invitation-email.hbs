<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>You're Invited to Reveal POS</title>

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f3f0ff;

      font-family:
        -apple-system,
        BlinkMacSystemFont,
        'Segoe UI',
        'Roboto',
        'Oxygen',
        'Ubuntu',
        'Cantarell',
        'Fira Sans',
        'Droid Sans',
        'Helvetica Neue',
        sans-serif;

      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    table {
      border-collapse: collapse;
      border-spacing: 0;
    }

    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
    }

    .header {
      background:
        linear-gradient(
          135deg,
          #3a1bb5 0%,
          #5227ff 100%
        );

      padding: 48px 40px;
      text-align: center;
    }

    .logo-text {
      font-size: 34px;
      font-weight: 700;
      color: #ffffff;
      margin: 0;
      letter-spacing: -0.5px;
    }

    .header-subtitle {
      color: #c4b5fd;
      font-size: 14px;
      font-weight: 500;
      margin-top: 10px;
      letter-spacing: 0.5px;
    }

    .content {
      padding: 48px 40px;
    }

    .welcome-badge {
      display: inline-block;

      background:
        linear-gradient(
          135deg,
          #3a1bb5 0%,
          #5227ff 100%
        );

      color: #ffffff;
      padding: 8px 20px;
      border-radius: 20px;

      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;

      margin-bottom: 24px;
    }

    .greeting {
      font-size: 28px;
      font-weight: 700;
      color: #1f2937;
      margin: 0 0 20px 0;
    }

    .message {
      font-size: 16px;
      line-height: 1.7;
      color: #6b7280;
      margin-bottom: 24px;
    }

    .hero-section {
      background:
        linear-gradient(
          135deg,
          #ede9ff 0%,
          #ddd6fe 100%
        );

      border: 2px solid #5227ff;
      border-radius: 16px;

      padding: 36px 28px;
      text-align: center;
      margin: 32px 0;

      box-shadow:
        0 4px 6px -1px rgba(82,39,255,0.1),
        0 2px 4px -1px rgba(82,39,255,0.06);
    }

    .hero-icon {
      font-size: 52px;
      margin-bottom: 18px;
      display: block;
    }

    .hero-title {
      font-size: 24px;
      font-weight: 700;
      color: #2d0f99;
      margin-bottom: 12px;
    }

    .hero-description {
      font-size: 15px;
      line-height: 1.7;
      color: #5227ff;
    }

    .button-container {
      text-align: center;
      margin: 40px 0;
    }

    .btn-primary {
      display: inline-block;
      background-color: #5227ff;
      color: #ffffff !important;
      padding: 16px 34px;
      border-radius: 10px;
      text-decoration: none;
      font-size: 16px;
      font-weight: 600;
      box-shadow: 0 4px 6px rgba(82, 39, 255, 0.2);
    }

    .help-section {
      background-color: #f9fafb;
      border-radius: 12px;
      padding: 24px;
      text-align: center;
      margin-top: 36px;
    }

    .help-text {
      font-size: 14px;
      color: #6b7280;
      margin-bottom: 12px;
    }

    .support-link {
      color: #5227ff;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
    }

    .footer {
      background-color: #f9fafb;
      padding: 40px;
      text-align: center;
      border-top: 1px solid #e5e7eb;
    }

    .footer-text {
      font-size: 13px;
      line-height: 1.6;
      color: #9ca3af;
      margin-bottom: 16px;
    }

    .footer-links {
      margin: 16px 0;
    }

    .footer-link {
      color: #5227ff;
      text-decoration: none;
      font-size: 13px;
      margin: 0 10px;
      font-weight: 500;
    }

    .copyright {
      font-size: 12px;
      color: #9ca3af;
      margin-top: 20px;
    }

    @media only screen and (max-width: 600px) {
      .header,
      .content,
      .footer {
        padding: 32px 24px !important;
      }

      .hero-section {
        padding: 28px 20px !important;
      }

      .greeting {
        font-size: 24px !important;
      }
    }
  </style>
</head>

<body>

  <table
    role="presentation"
    width="100%"
    cellspacing="0"
    cellpadding="0"
    border="0"
  >
    <tr>
      <td
        align="center"
        style="padding: 40px 20px;"
      >

        <table
          class="email-container"
          role="presentation"
          width="600"
          cellspacing="0"
          cellpadding="0"
          border="0"
        >

          <!-- Header -->
          <tr>
            <td class="header">
              <h1 class="logo-text">
                Reveal POS
              </h1>
              <p class="header-subtitle">
                SELL • MANAGE • GROW
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td class="content">

              <div style="text-align:center;">
                <span class="welcome-badge">
                  ✉️ Invitation
                </span>
              </div>

              <h2 class="greeting">
                Hi {{name}},
              </h2>

              <p class="message">
                You have been invited to join <strong>Reveal POS</strong>. 
                An account has been provisioned for you, and your team is ready to get started.
              </p>

              <!-- Hero Section outlining the role -->
              <div class="hero-section">
                <span class="hero-icon">
                  💼
                </span>
                <h3 class="hero-title">
                  Your Assigned Role: {{role}}
                </h3>
                <p class="hero-description">
                  Employee Number: <strong>{{employeeCode}}</strong>
                </p>
                <p class="hero-description">
                  As a {{role}}, you will have access to all the tools necessary to help manage operations, track performance, and streamline your business workflow.
                </p>
              </div>

              <p class="message" style="text-align: center;">
                To accept this invitation and set up your account details, click the button below.
              </p>

              <!-- Styled CTA Button -->
              <div class="button-container">
                <a href="{{invitation_link}}" class="btn-primary">
                  Accept Invitation
                </a>
              </div>

              <!-- Help -->
              <div class="help-section">
                <p class="help-text">
                  Questions about your role or access?
                </p>
                <a
                  href="#"
                  class="support-link"
                >
                  Contact Support Team →
                </a>
              </div>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="footer">

              <p class="footer-text">
                You're receiving this email because you were invited to a Reveal POS workspace. 
                If you did not expect this invitation, you can safely ignore this email.
              </p>

              <div class="footer-links">
                <a href="#" class="footer-link">
                  Privacy Policy
                </a>
                <a href="#" class="footer-link">
                  Terms of Service
                </a>
                <a href="#" class="footer-link">
                  Help Center
                </a>
              </div>

              <p class="copyright">
                &copy; {{year}} Reveal POS.
                All rights reserved.
                <br>
                UpperHill, Nairobi, Kenya
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
